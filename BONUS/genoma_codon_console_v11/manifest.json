{
  "manifest_version": 3,
  "name": "GENOMA Codon Console",
  "version": "11.0.0",
  "description": "LLM-first codon console. Transcribe a live page into a small operating map, mutate bound codons, and apply safe reversible patches.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "side_panel": { "default_path": "panel/panel.html" },
  "action": { "default_popup": "popup/popup.html", "default_title": "GENOMA Codon Console" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self';" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
